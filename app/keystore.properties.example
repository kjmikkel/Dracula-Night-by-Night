# Copy to keystore.properties (git-ignored) to sign release builds, or set the environment variables
# DNBN_STORE_FILE, DNBN_STORE_PASSWORD, DNBN_KEY_ALIAS and DNBN_KEY_PASSWORD instead.
# A relative storeFile is read from this folder. Set all four or none: a partial set fails the build.
# Never commit the real file or the keystore.
storeFile=/path/to/release.jks
storePassword=
keyAlias=
keyPassword=
